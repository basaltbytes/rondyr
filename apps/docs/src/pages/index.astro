---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ContainerSection } from "lucode-starlight/components";

import reviewScreenshot from "../../../../docs/screenshots/review.webp";
import {
  comparisonRows,
  comparisonTradeoff,
  faqItems,
  firstRun,
  formSnippet,
  landingMeta,
} from "../landing.ts";
import { pageRoute } from "../repository/documents.ts";
import { sidebar } from "../sidebar.ts";

const titles = new Map((await getCollection("docs")).map(({ id, data }) => [id, data.title]));
const groups = sidebar.map(({ label, items }) => ({
  label,
  pages: items.map(({ slug, label: pageLabel }) => ({
    href: pageRoute(slug),
    title: pageLabel ?? titles.get(slug) ?? slug,
  })),
}));
---

<StarlightPage
  frontmatter={{
    title: "Rondyr",
    head: [{ tag: "title", content: landingMeta.title }],
    description: landingMeta.description,
    template: "splash",
    hero: {
      title: "The gatekeeper for your forms.",
      tagline:
        "Rondyr is an open-source, self-hosted form backend with classifier-model spam filtering that runs in your own Cloudflare account. Describe your business and let decision models do the gatekeeping.",
      actions: [],
    },
  }}
>
  <ContainerSection width="xl">
    <div class="not-content grid gap-16 pb-16 [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:decoration-brand [&_a]:underline-offset-[0.2em] [&_a:hover]:text-brand [&_code]:rounded-[0.3em] [&_code]:bg-surface [&_code]:px-[0.3em] [&_code]:py-[0.1em] [&_code]:text-[0.9em]">
      <section class="pt-12" aria-labelledby="first-run-heading">
        <h2
          id="first-run-heading"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          First run
        </h2>
        <ol class="m-0 grid list-none gap-8 p-0 lg:grid-cols-3 lg:gap-10">
          {
            firstRun.map((step, index) => (
              <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] grid-rows-[auto_1fr] content-start gap-x-3">
                <span
                  class="row-span-2 grid size-9 place-items-center rounded-full border-[1.5px] border-brand font-bold tabular-nums text-brand"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <h3 class="m-0 self-center text-[1.0625rem] font-semibold text-foreground">
                  {step.title}
                </h3>
                <p class="mt-2 leading-[1.65] text-muted" set:html={step.html} />
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="grid gap-x-12 gap-y-6 border-t border-border pt-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center"
        aria-labelledby="form-on-your-site"
      >
        <div class="space-y-4">
          <h2
            id="form-on-your-site"
            class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
          >
            The form on your site
          </h2>
          <p class="leading-[1.65] text-muted">
            Point any HTML{" "}
            <code class="rounded-[0.3em] bg-surface px-[0.3em] py-[0.1em] text-[0.95em]">&lt;form&gt;</code>{" "}
            at Rondyr from a static site (Astro, Next.js, Hugo, Eleventy, or plain HTML), and it saves every message before screening it for spam, unsolicited sales pitches, and business relevance.
          </p>
          <p class="leading-[1.65] text-muted">
            A regular HTML form shows a confirmation page or redirects visitors to your own thank-you page. The same URL accepts cross-origin JSON from <code>fetch</code>, or server-side submissions through the <a href="/api/">HTTP API</a>.
          </p>
          <p class="leading-[1.65] text-muted">
            <a href="/forms/">Put a form on your site</a>
          </p>
        </div>
        <div class="min-w-0">
          <Code code={formSnippet} lang="html" title="contact.html" />
        </div>
      </section>

      <section class="border-t border-border pt-12" aria-labelledby="message-path">
        <h2
          id="message-path"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          Message lifecycle
        </h2>
        <dl class="m-0 grid gap-x-10 gap-y-8 md:grid-cols-2 xl:grid-cols-3">
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Saved first</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Every submission is saved in your Cloudflare account before Rondyr answers your site, so a temporary outage doesn't drop messages.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Classifier-model spam filtering</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Jev on Workers AI or the OpenAI Decisions API scores each message for spam, unsolicited sales pitches, and (when you describe your business) relevance. Layer <a href="/spam-protection/">honeypot fields, Cloudflare Turnstile, and rate limits</a> in front of the model.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Quarantined, not deleted</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Probable spam, uncertain messages, sales pitches, off-topic notes, and analysis errors wait in <a href="/inbox/"><strong>To review</strong></a> with a plain reason until a person accepts or archives them.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Forwarded automatically</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Accepted messages go out by <a href="/email/">email</a> (Resend or Cloudflare Email Sending), <a href="/webhooks/">HMAC-signed webhooks</a>, or <a href="/connectors/">Discord, Slack, and Airtable connectors</a>. With the <a href="/emdash/">EmDash plugin</a>, editors review messages right inside EmDash.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Self-hosted and owned by you</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Messages stay in your own Cloudflare account with configurable retention and CSV or JSON Lines exports. You pay Cloudflare directly with no per-submission SaaS markup; see <a href="/costs/">Costs and limits</a>.
            </dd>
          </div>
        </dl>
      </section>

      <section class="border-t border-border pt-12" aria-labelledby="quarantine-preview">
        <div class="mb-6 max-w-2xl space-y-2">
          <h2
            id="quarantine-preview"
            class="m-0 text-2xl font-[650] tracking-[-0.015em] text-foreground"
          >
            Quarantine inbox
          </h2>
          <p class="m-0 leading-[1.65] text-muted">
            Every flagged message shows why the classifier or bot check set it aside, with one-click <strong>Accept and send</strong> or <strong>Archive</strong> actions.
          </p>
        </div>
        <figure class="m-0 overflow-hidden rounded-lg border border-border bg-surface">
          <Image
            src={reviewScreenshot}
            alt="Rondyr dashboard To review folder showing quarantined messages labeled Probable spam, Unsolicited sales outreach, Honeypot field filled, Uncertain classification, and Unrelated to your business, with Archive and Accept and send actions"
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <section class="border-t border-border pt-12" aria-labelledby="comparison">
        <div class="mb-6 max-w-2xl space-y-2">
          <h2
            id="comparison"
            class="m-0 text-2xl font-[650] tracking-[-0.015em] text-foreground"
          >
            Rondyr vs. hosted form backends
          </h2>
          <p class="m-0 leading-[1.65] text-muted">
            How self-hosting Rondyr compares with hosted form services like Formspree, Basin, or Web3Forms.
          </p>
        </div>
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="m-0 w-full border-collapse text-left text-[0.9375rem] leading-[1.6]">
            <thead>
              <tr class="border-b border-border bg-surface text-foreground">
                <th scope="col" class="px-4 py-3 font-semibold">Aspect</th>
                <th scope="col" class="px-4 py-3 font-semibold">Rondyr (self-hosted)</th>
                <th scope="col" class="px-4 py-3 font-semibold">Hosted form SaaS</th>
              </tr>
            </thead>
            <tbody>
              {
                comparisonRows.map((row) => (
                  <tr class="border-t border-border align-top">
                    <th scope="row" class="px-4 py-3 font-medium text-foreground">
                      {row.aspect}
                    </th>
                    <td class="px-4 py-3 text-foreground">{row.rondyr}</td>
                    <td class="px-4 py-3 text-muted">{row.hosted}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm leading-[1.6] text-subtle">{comparisonTradeoff}</p>
      </section>

      <section class="border-t border-border pt-12" aria-labelledby="faq">
        <h2
          id="faq"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          Frequently asked questions
        </h2>
        <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
          {
            faqItems.map((item) => (
              <div class="space-y-2 border-t border-border pt-4">
                <h3 class="m-0 text-[1.0625rem] font-semibold text-foreground">
                  {item.question}
                </h3>
                <p class="m-0 leading-[1.65] text-muted" set:html={item.html} />
              </div>
            ))
          }
        </div>
      </section>

      <section class="border-t border-border pt-12" aria-labelledby="documentation">
        <h2
          id="documentation"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          Documentation
        </h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,13rem),1fr))] gap-8">
          {
            groups.map((group) => (
              <div>
                <h3 class="m-0 mb-3 text-[0.8125rem] font-semibold tracking-[0.08em] text-subtle uppercase">
                  {group.label}
                </h3>
                <ul class="m-0 grid list-none gap-2 p-0">
                  {group.pages.map((page) => (
                    <li>
                      <a href={page.href}>{page.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </ContainerSection>
</StarlightPage>
