---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ContainerSection } from "lucode-starlight/components";

import reviewScreenshotDark from "../../../../docs/screenshots/review-dark.webp";
import reviewScreenshot from "../../../../docs/screenshots/review.webp";
import MessageLifecycle from "../components/lifecycle/message-lifecycle.astro";
import {
  comparisonRows,
  comparisonTradeoff,
  deployUrl,
  faqItems,
  features,
  firstRun,
  landingMeta,
} from "../landing.ts";
import { pageRoute } from "../repository/documents.ts";
import { sidebar } from "../sidebar.ts";

const titles = new Map((await getCollection("docs")).map(({ id, data }) => [id, data.title]));
const groups = sidebar.map(({ label, items }) => ({
  label,
  pages: items.map(({ slug, label: pageLabel }) => ({
    href: pageRoute(slug),
    title: pageLabel ?? titles.get(slug) ?? slug,
  })),
}));

// A section below the lifecycle: its heading in the column of the lifecycle's step texts,
// its content in the column of the windows.
const section =
  "grid gap-x-14 gap-y-8 border-t border-border pt-14 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)]";
const heading = "m-0 text-2xl leading-tight font-[650] tracking-[-0.015em] text-balance text-foreground";
const lede = "mt-3 mb-0 leading-[1.65] text-pretty text-muted";
---

<StarlightPage
  frontmatter={{
    title: "Rondyr",
    head: [{ tag: "title", content: landingMeta.title }],
    description: landingMeta.description,
    template: "splash",
    hero: {
      title: "The gatekeeper for your forms.",
      tagline:
        "Rondyr is an open-source, self-hosted form backend with classifier-model spam filtering that runs in your own Cloudflare account. Describe your business and let decision models do the gatekeeping.",
      actions: [],
    },
  }}
>
  <ContainerSection width="xl">
    <div class="not-content pt-14 pb-20 lg:pt-20">
      <MessageLifecycle />
    </div>
  </ContainerSection>

  <ContainerSection width="xl">
    <div
      class="not-content grid gap-16 pb-16 [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:decoration-brand [&_a]:underline-offset-[0.2em] [&_a:hover]:text-brand [&_code]:rounded-[0.3em] [&_code]:bg-surface [&_code]:px-[0.3em] [&_code]:py-[0.1em] [&_code]:text-[0.9em]"
    >
      <section class={section} aria-labelledby="features">
        <div>
          <h2 id="features" class={heading}>Storage, classification and delivery</h2>
          <p class={lede}>What Rondyr does with every message, on every form.</p>
        </div>
        <dl class="m-0 grid gap-x-12 gap-y-9 sm:grid-cols-2">
          {
            features.map((feature) => (
              <div>
                <dt class="text-[1.0625rem] font-semibold text-foreground">{feature.title}</dt>
                <dd class="m-0 mt-2 leading-[1.65] text-pretty text-muted" set:html={feature.html} />
              </div>
            ))
          }
        </dl>
      </section>

      <section class={section} aria-labelledby="quarantine-preview">
        <div>
          <h2 id="quarantine-preview" class={heading}>The To review folder</h2>
          <p class={lede}>
            Every message that Rondyr quarantines shows the check or the score that sent it there, next to <strong>Accept and send</strong> and <strong>Archive</strong>.
          </p>
        </div>
        <figure class="m-0 overflow-hidden rounded-2xl border border-border bg-surface">
          {
            // One screenshot for each theme of the site; the dark one repeats the light one.
            [
              { src: reviewScreenshot, theme: "light" },
              { src: reviewScreenshotDark, theme: "dark" },
            ].map(({ src, theme }) => (
              <Image
                src={src}
                alt={
                  theme === "light"
                    ? "Rondyr dashboard To review folder showing quarantined messages labeled Probable spam, Sales outreach, Honeypot field filled, Possible spam, and Off-topic, with Archive and Accept and send actions"
                    : ""
                }
                class:list={["review-screenshot block h-auto w-full", `review-screenshot-${theme}`]}
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </figure>
      </section>

      <section class={section} aria-labelledby="comparison">
        <div>
          <h2 id="comparison" class={heading}>Rondyr vs. hosted form backends</h2>
          <p class={lede}>
            How self-hosting Rondyr compares with hosted form services like Formspree, Basin, or Web3Forms.
          </p>
        </div>
        <div>
          <table class="comparison m-0 w-full border-collapse text-left text-[0.9375rem] leading-[1.6]">
            <thead class="max-md:sr-only">
              <tr>
                <th scope="col" class="w-[24%] pb-3 font-medium text-subtle">Aspect</th>
                <th
                  scope="col"
                  class="rounded-t-xl border-x border-t border-border bg-surface px-5 pt-4 pb-3 font-semibold text-foreground"
                >
                  Rondyr, self-hosted
                </th>
                <th scope="col" class="px-5 pb-3 font-medium text-subtle">Hosted form SaaS</th>
              </tr>
            </thead>
            <tbody>
              {
                comparisonRows.map((row, index) => (
                  <tr class="align-top max-md:block max-md:border-t max-md:border-border max-md:py-5">
                    <th
                      scope="row"
                      class="border-border py-4 pr-4 font-semibold text-foreground max-md:block max-md:p-0 md:border-t"
                    >
                      {row.aspect}
                    </th>
                    <td
                      data-label="Rondyr"
                      class:list={[
                        "border-border bg-surface px-5 py-4 text-foreground max-md:mt-3 max-md:block max-md:rounded-lg max-md:border md:border-x md:border-t",
                        index === comparisonRows.length - 1 && "md:rounded-b-xl md:border-b",
                      ]}
                    >
                      {row.rondyr}
                    </td>
                    <td
                      data-label="Hosted form SaaS"
                      class="border-border px-5 py-4 text-muted max-md:mt-2 max-md:block max-md:px-0 max-md:pb-0 md:border-t"
                    >
                      {row.hosted}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="mt-6 mb-0 text-sm leading-[1.6] text-pretty text-subtle">{comparisonTradeoff}</p>
        </div>
      </section>

      <section class={section} aria-labelledby="first-run-heading">
        <div>
          <h2 id="first-run-heading" class={heading}>First run</h2>
          <p class={lede}>A few minutes in the browser, with no terminal.</p>
          <a
            class="mt-6 inline-flex rounded-md focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand"
            href={deployUrl}
          >
            <img
              class="block h-10 w-auto"
              src="https://deploy.workers.cloudflare.com/button"
              alt="Deploy to Cloudflare"
              width="165"
              height="32"
              loading="lazy"
            />
          </a>
          <p class="mt-4 mb-0 text-sm"><a href="/deployment/">Read the deployment guide</a></p>
        </div>
        <ol class="m-0 grid list-none gap-8 p-0">
          {
            firstRun.map((step, index) => (
              <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] grid-rows-[auto_1fr] content-start gap-x-4">
                <span
                  class="row-span-2 grid size-9 place-items-center rounded-full border-[1.5px] border-brand font-bold tabular-nums text-brand"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <h3 class="m-0 self-center text-[1.0625rem] font-semibold text-foreground">
                  {step.title}
                </h3>
                <p class="mt-2 mb-0 max-w-[62ch] leading-[1.65] text-pretty text-muted" set:html={step.html} />
              </li>
            ))
          }
        </ol>
      </section>

      <section class={section} aria-labelledby="faq">
        <div>
          <h2 id="faq" class={heading}>Frequently asked questions</h2>
        </div>
        <div class="border-b border-border">
          {
            faqItems.map((item) => (
              <details class="faq group border-t border-border">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 text-[1.0625rem] font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand [&::-webkit-details-marker]:hidden">
                  <h3 class="m-0 text-[1.0625rem] font-semibold text-pretty">{item.question}</h3>
                  <svg
                    class="mt-1.5 size-4 shrink-0 text-subtle transition-transform duration-200 ease-out group-open:rotate-45 motion-reduce:transition-none"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M8 2.5v11M2.5 8h11"></path>
                  </svg>
                </summary>
                <p class="m-0 max-w-[68ch] pb-5 leading-[1.65] text-pretty text-muted" set:html={item.html} />
              </details>
            ))
          }
        </div>
      </section>

      <section class={section} aria-labelledby="documentation">
        <div>
          <h2 id="documentation" class={heading}>Documentation</h2>
        </div>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,12rem),1fr))] gap-8">
          {
            groups.map((group) => (
              <div>
                <h3 class="m-0 mb-3 text-[0.8125rem] font-semibold text-subtle">{group.label}</h3>
                <ul class="m-0 grid list-none gap-2 p-0">
                  {group.pages.map((page) => (
                    <li>
                      <a href={page.href}>{page.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </ContainerSection>
</StarlightPage>

<style is:global>
  /* The screenshot of the dashboard in the theme of the site. */
  :root[data-theme="dark"] .review-screenshot-light,
  :root:not([data-theme="dark"]) .review-screenshot-dark {
    display: none;
  }
</style>

<style>
  /* Under 48rem a comparison row is a stack, so each answer says whose it is. */
  @media (width < 48rem) {
    .comparison td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.25rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--gray-3);
    }
  }
</style>
