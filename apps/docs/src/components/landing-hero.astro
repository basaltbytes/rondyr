---
// Starlight renders this component instead of the page title on a page with `hero` in its
// frontmatter. Only the landing page has one: its first screen is the pitch, the Deploy to
// Cloudflare button, and the agent prompt card with overlapping harness logos.
import { Code } from "@astrojs/starlight/components";
import antigravityIcon from "@lobehub/icons-static-svg/icons/antigravity-color.svg?raw";
import claudeCodeIcon from "@lobehub/icons-static-svg/icons/claudecode-color.svg?raw";
import codexIcon from "@lobehub/icons-static-svg/icons/codex-color.svg?raw";
import cursorIcon from "@lobehub/icons-static-svg/icons/cursor.svg?raw";
import openaiIcon from "@lobehub/icons-static-svg/icons/openai.svg?raw";
import opencodeIcon from "@lobehub/icons-static-svg/icons/opencode.svg?raw";
import typesafeAiIcon from "@lobehub/icons-static-svg/icons/typesafeai.svg?raw";
import { ContainerSection } from "lucode-starlight/components";

import mark from "../../../../docs/brand/rondyr-mark.svg?raw";

import { agentPrompt, deployUrl } from "../landing.ts";

const { hero } = Astro.locals.starlightRoute.entry.data;
const title = hero?.title ?? "";

const harnesses = [
  { name: "Claude Code", svg: claudeCodeIcon },
  { name: "OpenAI Codex", svg: codexIcon },
  { name: "Cursor", svg: cursorIcon },
  { name: "OpenCode", svg: opencodeIcon },
  { name: "Antigravity", svg: antigravityIcon },
];
---

<ContainerSection width="xl">
  <section class="landing-hero" aria-labelledby="_top">
    <div class="pitch">
      <div class="mark brand-ink" aria-hidden="true"><Fragment set:html={mark} /></div>
      <h1 id="_top" data-page-title>{title}</h1>
      <p class="tagline">
        Rondyr is a form backend with spam filtering that runs in your own Cloudflare account. Point
        your site's <code>&lt;form&gt;</code> at it, and Rondyr saves every message before screening
        it with{" "}
        <span class="inline-brand">
          <span class="brand-icon brand-icon-jev" aria-hidden="true"><Fragment set:html={typesafeAiIcon} /></span>
          <span>Jev</span>
        </span>{" "}
        or{" "}
        <span class="inline-brand">
          <span class="brand-icon" aria-hidden="true"><Fragment set:html={openaiIcon} /></span>
          <span>OpenAI Decisions</span>
        </span>{" "}
        for spam, sales pitches, and relevance to your business. Anything doubtful waits in
        quarantine until you accept or archive it.
      </p>
      <div class="actions">
        <a class="deploy" href={deployUrl}>
          <img
            src="https://deploy.workers.cloudflare.com/button"
            alt="Deploy to Cloudflare"
            width="165"
            height="32"
          />
        </a>
        <a class="guide" href="/deployment/">Read the deployment guide</a>
      </div>
      <p class="plan">
        Rondyr needs <strong>Workers Paid</strong>, at least $5 a month per Cloudflare account. On
        Workers Free, sign-in can fail and free daily limits run out quickly.{" "}
        <a href="/costs/">Costs and limits</a>
      </p>
      <p class="plan">
        Prefer to deploy from a fork with Alchemy and GitHub Actions, on your own domain?{" "}
        <a href="/deployment/#deploy-with-alchemy-and-github-actions">Deploy with Alchemy</a>
      </p>
    </div>

    <div class="agent-card">
      <div class="agent-header">
        <div class="harness-stack" aria-label="Works with Claude Code, OpenAI Codex, Cursor, OpenCode, and Antigravity">
          {
            harnesses.map((harness) => (
              <span class="harness-badge" title={harness.name} aria-hidden="true">
                <Fragment set:html={harness.svg} />
              </span>
            ))
          }
        </div>
        <h2>Copy this prompt for your agent</h2>
      </div>
      <div class="agent-code">
        <Code code={agentPrompt} lang="markdown" title="prompt.md" />
      </div>
    </div>
  </section>
</ContainerSection>

<style>
  .landing-hero {
    display: grid;
    gap: calc(var(--spacing) * 10);
    padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 8);
  }

  @media (min-width: 64rem) {
    .landing-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.05fr);
      gap: calc(var(--spacing) * 14);
      align-items: baseline;
      padding-block-start: calc(var(--spacing) * 16);
    }
  }

  .mark :global(svg) {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    margin-block-end: calc(var(--spacing) * 6);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
    color: var(--foreground);
  }

  .tagline {
    margin-block: calc(var(--spacing) * 6) 0;
    max-width: 38rem;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--gray-2);
  }

  .tagline :global(code) {
    font-size: 0.95em;
    padding: 0.1em 0.3em;
    border-radius: 0.3em;
    background: var(--gray-7);
  }

  .inline-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
    font-weight: 500;
    color: var(--foreground);
    vertical-align: bottom;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .brand-icon {
    display: inline-flex;
    align-items: center;
  }

  .brand-icon :global(svg) {
    width: 1em;
    height: 1em;
  }

  .brand-icon-jev {
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    border-radius: 0.25em;
    background: #e551ba;
    color: #1e1e1e;
  }

  .brand-icon-jev :global(svg) {
    width: 0.8em;
    height: 0.8em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 3) calc(var(--spacing) * 6);
    margin-block-start: calc(var(--spacing) * 8);
  }

  .deploy {
    display: inline-flex;
    border-radius: 0.375rem;
  }

  .deploy img {
    display: block;
    height: 2.5rem;
    width: auto;
  }

  .deploy:focus-visible,
  .guide:focus-visible {
    outline: 2px solid var(--rondyr-accent);
    outline-offset: 3px;
  }

  .guide {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--rondyr-accent);
    text-underline-offset: 0.3em;
  }

  .guide:hover {
    color: var(--rondyr-accent);
  }

  .plan {
    margin-block-start: calc(var(--spacing) * 6);
    max-width: 38rem;
    padding-inline-start: calc(var(--spacing) * 4);
    border-inline-start: 3px solid var(--rondyr-accent);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--gray-3);
  }

  .plan strong {
    color: var(--foreground);
  }

  .plan a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration-color: var(--rondyr-accent);
    text-underline-offset: 0.2em;
  }

  .agent-card {
    min-width: 0;
    padding: calc(var(--spacing) * 5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--gray-7);
  }

  @media (min-width: 40rem) {
    .agent-card {
      padding: calc(var(--spacing) * 6);
    }
  }

  .agent-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    margin-block-end: calc(var(--spacing) * 4);
  }

  .harness-stack {
    display: inline-flex;
    align-items: center;
    padding-inline-end: 0.45rem;
  }

  .harness-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    margin-inline-end: -0.45rem;
    border-radius: 999px;
    border: 2px solid var(--gray-7);
    background: var(--background);
    color: var(--foreground);
  }

  .harness-badge :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .agent-header h2 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .agent-code {
    min-width: 0;
  }

  .agent-code :global(.expressive-code pre) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .agent-code :global(.expressive-code .ec-line .code) {
    white-space: pre-wrap;
  }

  .agent-code :global(.expressive-code .copy button) {
    opacity: 0.85;
  }

  .agent-code :global(.expressive-code .copy button:hover),
  .agent-code :global(.expressive-code .copy button:focus-visible) {
    opacity: 1;
  }
</style>
