{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rondyr",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/f", "/f/*", "/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CLASSIFICATION_QUEUE_NAME": "rondyr-classification",
    "DELIVERY_QUEUE_NAME": "rondyr-delivery",
    "CLASSIFICATION_DEAD_LETTER_QUEUE_NAME": "rondyr-classification-dead-letter",
    "DELIVERY_DEAD_LETTER_QUEUE_NAME": "rondyr-delivery-dead-letter"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rondyr-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./database/migrations",
      "migrations_pattern": "./database/migrations/*/migration.sql"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLASSIFICATION_QUEUE",
        "queue": "rondyr-classification"
      },
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "rondyr-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "rondyr-classification",
        "dead_letter_queue": "rondyr-classification-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "rondyr-delivery",
        "dead_letter_queue": "rondyr-delivery-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "rondyr-classification-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      },
      {
        "queue": "rondyr-delivery-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMIT",
      "namespace_id": "7001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "TARGET_TEST_RATE_LIMIT",
      "namespace_id": "7002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Submissions.DomainDirectory",
        "class_name": "DomainDirectory"
      },
      {
        "name": "Submissions.SubmissionAggregate",
        "class_name": "SubmissionAggregate"
      },
      {
        "name": "Submissions.ClassificationPolicy",
        "class_name": "ClassificationPolicy"
      },
      {
        "name": "Submissions.DeliveryPolicy",
        "class_name": "DeliveryPolicy"
      },
      {
        "name": "Submissions.InboxProjection",
        "class_name": "InboxProjection"
      },
      {
        "name": "Submissions.InboxProjectionRun",
        "class_name": "InboxProjectionRun"
      },
      {
        "name": "Submissions.ClassifySubmissionWorkflow",
        "class_name": "ClassifySubmissionWorkflow"
      },
      {
        "name": "CronHeartbeatObject",
        "class_name": "CronHeartbeatObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "submission-review",
      "new_sqlite_classes": [
        "DomainDirectory",
        "SubmissionAggregate",
        "ClassificationPolicy",
        "InboxProjection",
        "InboxProjectionRun",
        "ClassifySubmissionWorkflow"
      ]
    },
    {
      "tag": "deliveries",
      "new_sqlite_classes": ["DeliveryPolicy"]
    },
    {
      "tag": "cron-heartbeat",
      "new_sqlite_classes": ["CronHeartbeatObject"]
    }
  ],
  "workflows": [
    {
      "name": "rondyr-submissions-backfill",
      "binding": "Submissions.DomainBackfill",
      "class_name": "DomainBackfill"
    }
  ],
  "env": {
    "cloudflare-email": {
      "vars": {
        "CLASSIFICATION_QUEUE_NAME": "rondyr-classification",
        "DELIVERY_QUEUE_NAME": "rondyr-delivery",
        "CLASSIFICATION_DEAD_LETTER_QUEUE_NAME": "rondyr-classification-dead-letter",
        "DELIVERY_DEAD_LETTER_QUEUE_NAME": "rondyr-delivery-dead-letter",
        "RONDYR_EMAIL_PROVIDER": "cloudflare"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rondyr-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "./database/migrations",
          "migrations_pattern": "./database/migrations/*/migration.sql"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "CLASSIFICATION_QUEUE",
            "queue": "rondyr-classification"
          },
          {
            "binding": "DELIVERY_QUEUE",
            "queue": "rondyr-delivery"
          }
        ],
        "consumers": [
          {
            "queue": "rondyr-classification",
            "dead_letter_queue": "rondyr-classification-dead-letter",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3
          },
          {
            "queue": "rondyr-delivery",
            "dead_letter_queue": "rondyr-delivery-dead-letter",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3
          },
          {
            "queue": "rondyr-classification-dead-letter",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          },
          {
            "queue": "rondyr-delivery-dead-letter",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          }
        ]
      },
      "ratelimits": [
        {
          "name": "CLIENT_RATE_LIMIT",
          "namespace_id": "7001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "TARGET_TEST_RATE_LIMIT",
          "namespace_id": "7002",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Submissions.DomainDirectory",
            "class_name": "DomainDirectory"
          },
          {
            "name": "Submissions.SubmissionAggregate",
            "class_name": "SubmissionAggregate"
          },
          {
            "name": "Submissions.ClassificationPolicy",
            "class_name": "ClassificationPolicy"
          },
          {
            "name": "Submissions.DeliveryPolicy",
            "class_name": "DeliveryPolicy"
          },
          {
            "name": "Submissions.InboxProjection",
            "class_name": "InboxProjection"
          },
          {
            "name": "Submissions.InboxProjectionRun",
            "class_name": "InboxProjectionRun"
          },
          {
            "name": "Submissions.ClassifySubmissionWorkflow",
            "class_name": "ClassifySubmissionWorkflow"
          },
          {
            "name": "CronHeartbeatObject",
            "class_name": "CronHeartbeatObject"
          }
        ]
      },
      "workflows": [
        {
          "name": "rondyr-submissions-backfill",
          "binding": "Submissions.DomainBackfill",
          "class_name": "DomainBackfill"
        }
      ],
      "send_email": [
        {
          "name": "CLOUDFLARE_EMAIL"
        }
      ]
    }
  }
}
