# Generate independently with openssl rand -hex 32 (legacy fallback: BETTER_AUTH_SECRET).
RONDYR_SESSION_SECRET=
# Set only while creating the first operator account. Use a different secret.
# RONDYR_SETUP_TOKEN=
# Optional operator recovery token (at least 32 characters) for passkey recovery or
# custom-domain migration when Email OTP is unavailable. Remove after use.
# RONDYR_RECOVERY_TOKEN=
# Encrypts webhook signing secrets in D1. Generate it with openssl rand -base64 32.
# Without it, webhook destinations cannot be created or rotated.
# RONDYR_SECRETS_KEY=
# For a deployed stage, use its canonical HTTPS origin (legacy fallback: BETTER_AUTH_URL).
# RONDYR_PUBLIC_URL=https://forms.example.com
# Select jev (default) or openai when deploying with Alchemy. openai calls the AI Gateway
# named default, which Cloudflare creates on the first request.
# RONDYR_CLASSIFIER=jev
# Email destinations and Email OTP sign-in need a sender address on a domain configured with
# the provider. Resend (default) also needs a sending API key. Cloudflare uses a Worker binding.
# See docs/email.md for setup.
# RESEND_API_KEY=
# RONDYR_EMAIL_FROM=forms@notifications.example.com
# Select resend (default) or cloudflare when deploying with Alchemy.
# RONDYR_EMAIL_PROVIDER=resend
