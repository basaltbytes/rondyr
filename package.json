{
  "name": "rondyr-workspace",
  "private": true,
  "description": "Self-hosted form backend with spam filtering that runs in your own Cloudflare account",
  "keywords": [
    "cloudflare-d1",
    "cloudflare-workers",
    "contact-form",
    "form-backend",
    "self-hosted",
    "spam-filter"
  ],
  "homepage": "https://github.com/basaltbytes/rondyr#readme",
  "bugs": {
    "url": "https://github.com/basaltbytes/rondyr/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/rondyr.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter rondyr run dev",
    "dev:demo": "pnpm --filter rondyr run dev:demo",
    "dev:alchemy": "pnpm --filter rondyr run dev:alchemy",
    "build": "pnpm --filter rondyr run build",
    "start": "pnpm --filter rondyr run start",
    "deploy": "pnpm --filter rondyr run deploy",
    "deploy:alchemy": "pnpm --filter rondyr run deploy:alchemy",
    "deploy:alchemy:plan": "pnpm --filter rondyr run deploy:alchemy:plan",
    "deploy:dry": "pnpm --filter rondyr run deploy:dry",
    "smoke": "pnpm --filter rondyr run smoke",
    "cf:types": "pnpm --filter rondyr run cf:types",
    "db:generate": "pnpm --filter rondyr run db:generate",
    "db:check": "pnpm --filter rondyr run db:check",
    "db:migrate": "pnpm --filter rondyr run db:migrate",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --recursive --sequential --if-present run typecheck",
    "test": "pnpm --recursive --sequential --if-present run test",
    "test:e2e": "pnpm --filter rondyr run test:e2e",
    "screenshots": "pnpm --filter rondyr run screenshots",
    "test:lint": "pnpm --filter @rondyr/oxlint run test",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"apps/rondyr/scripts/*.test.mjs\"",
    "knip": "knip",
    "doctor": "pnpm --filter rondyr run doctor",
    "evaluate": "pnpm --filter rondyr run evaluate",
    "i18n:check": "pnpm --filter rondyr run i18n:check",
    "i18n:extract": "pnpm --filter rondyr run i18n:extract",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release-github.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm knip && pnpm i18n:check && pnpm db:check && pnpm run doctor"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@shadcn/lint": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@11.28.9",
  "cloudflare": {
    "bindings": {
      "RONDYR_SETUP_TOKEN": {
        "description": "A passphrase of at least 32 characters that you choose now, for example from your password manager's generator. Rondyr asks for it once, on its setup page, to create the owner account, so nobody else who finds the address first can claim the instance. [Deployment guide](https://github.com/basaltbytes/rondyr/blob/main/docs/deployment.md#first-account)"
      }
    }
  }
}
