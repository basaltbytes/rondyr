---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import { ContainerSection } from "lucode-starlight/components";

import { firstRun, formSnippet } from "../landing.ts";
import { pageRoute } from "../repository/documents.ts";
import { sidebar } from "../sidebar.ts";

const titles = new Map((await getCollection("docs")).map(({ id, data }) => [id, data.title]));
const groups = sidebar.map(({ label, items }) => ({
  label,
  pages: items.map(({ slug, label: pageLabel }) => ({
    href: pageRoute(slug),
    title: pageLabel ?? titles.get(slug) ?? slug,
  })),
}));
---

<StarlightPage
  frontmatter={{
    title: "Rondyr",
    head: [{ tag: "title", content: "Rondyr: a form backend with spam filtering for Cloudflare" }],
    description:
      "Rondyr is a form backend with spam filtering that you deploy to your own Cloudflare account. Doubtful messages wait in quarantine for a person to decide.",
    template: "splash",
    hero: {
      title: "The gatekeeper for your forms.",
      tagline:
        "Rondyr is a form backend with classifier-model powered spam filtering that runs in your own Cloudflare account. Describe your business and let strong decision models do the gatekeeping.",
      actions: [],
    },
  }}
>
  <ContainerSection width="xl">
    <div class="not-content grid gap-16 pb-16 [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:decoration-brand [&_a]:underline-offset-[0.2em] [&_a:hover]:text-brand [&_code]:rounded-[0.3em] [&_code]:bg-surface [&_code]:px-[0.3em] [&_code]:py-[0.1em] [&_code]:text-[0.9em]">
      <section class="pt-12" aria-labelledby="first-run-heading">
        <h2
          id="first-run-heading"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          First run
        </h2>
        <ol class="m-0 grid list-none gap-8 p-0 lg:grid-cols-3 lg:gap-10">
          {
            firstRun.map((step, index) => (
              <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] grid-rows-[auto_1fr] content-start gap-x-3">
                <span
                  class="row-span-2 grid size-9 place-items-center rounded-full border-[1.5px] border-brand font-bold tabular-nums text-brand"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <h3 class="m-0 self-center text-[1.0625rem] font-semibold text-foreground">
                  {step.title}
                </h3>
                <p class="mt-2 leading-[1.65] text-muted" set:html={step.html} />
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="grid gap-x-12 gap-y-6 border-t border-border pt-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center"
        aria-labelledby="form-on-your-site"
      >
        <div class="space-y-4">
          <h2
            id="form-on-your-site"
            class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
          >
            The form on your site
          </h2>
          <p class="leading-[1.65] text-muted">
            Point your site's{" "}
            <code class="rounded-[0.3em] bg-surface px-[0.3em] py-[0.1em] text-[0.95em]">&lt;form&gt;</code>{" "}
            at it, and Rondyr saves every message before screening it for spam, sales pitches, and
            relevance to your business.
            <br/>
            A regular HTML form shows a confirmation page or redirects visitors to your own thank-you page.
            The same URL accepts JSON from <code>fetch</code> when you want to submit without leaving the page.
          </p>
          <p class="leading-[1.65] text-muted">
            <a href="/forms/">Put a form on your site</a>
          </p>
        </div>
        <div class="min-w-0">
          <Code code={formSnippet} lang="html" title="contact.html" />
        </div>
      </section>

      <section aria-labelledby="message-path">
        <h2
          id="message-path"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          Message lifecycle
        </h2>
        <dl class="m-0 grid gap-x-10 gap-y-8 md:grid-cols-2 xl:grid-cols-3">
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Saved first</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Every submission is saved in your Cloudflare account before Rondyr answers your site, so a
              temporary outage doesn't drop messages.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Screened for spam</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Jev on Workers AI or the OpenAI Decisions API scores each message for spam, unsolicited
              sales pitches, and (if you describe your business) whether it relates to what you do. You
              pick the model for your instance and can optionally use the second one for uncertain
              messages.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Quarantined, not deleted</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Probable spam, uncertain messages, sales pitches, off-topic notes, and analysis errors wait
              in <strong>To review</strong> with a plain reason until a person decides.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Forwarded automatically</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Accepted messages go out by <a href="/email/">email</a> (through Resend or Cloudflare Email
              Sending) or to <a href="/webhooks/">signed webhooks</a>. With the <a href="/emdash/">EmDash plugin</a>,
              editors review messages right inside EmDash.
            </dd>
          </div>
          <div class="border-t-2 border-foreground pt-4">
            <dt class="font-semibold text-foreground">Owned by you</dt>
            <dd class="mt-2 leading-[1.65] text-muted">
              Your messages stay in your Cloudflare account. They leave only in the emails, webhooks, and
              exports you configure.
            </dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="documentation">
        <h2
          id="documentation"
          class="m-0 mb-6 text-2xl font-[650] tracking-[-0.015em] text-foreground"
        >
          Documentation
        </h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,13rem),1fr))] gap-8">
          {
            groups.map((group) => (
              <div>
                <h3 class="m-0 mb-3 text-[0.8125rem] font-semibold tracking-[0.08em] text-subtle uppercase">
                  {group.label}
                </h3>
                <ul class="m-0 grid list-none gap-2 p-0">
                  {group.pages.map((page) => (
                    <li>
                      <a href={page.href}>{page.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </ContainerSection>
</StarlightPage>
