---
// The message lifecycle of the landing page: six steps down the page, each one a window
// that plays when the reader reaches it. The windows of Rondyr are excerpts of the
// dashboard, with its palette, its texts and its markup; director.ts plays them. Without
// JavaScript, or with reduced motion, every window shows the end of its step.
//
// The lifecycle follows one message at a time. What depends on the message is written once
// for each message in an element with data-message, and every one but the first is hidden;
// director.ts shows those of the message it follows.
import "../../styles/lifecycle.css";

import dashboardStylesheet from "../../../../rondyr/src/dashboard/dashboard.css?raw";
import { dashboardThemeCss } from "../../dashboard-theme.ts";
import {
  dashboardText as text,
  lifecycleIntro,
  lifecycleSteps,
  messages,
  story,
} from "../../lifecycle.ts";
import CheckRow from "./check-row.astro";
import Flux from "./flux.astro";
import Frame from "./frame.astro";
import Stage from "./stage.astro";
import Icon from "./ui-icon.astro";

const step = (id: (typeof lifecycleSteps)[number]["id"]) => {
  const index = lifecycleSteps.findIndex((candidate) => candidate.id === id);
  const found = lifecycleSteps[index];
  if (found === undefined) throw new Error(`The lifecycle has no step "${id}".`);
  return { step: found, number: index + 1 };
};

const { form, thresholds } = story;
const { outcome } = text;
const dashboard = "Rondyr dashboard";

// The address stays on one line of its field: where the field is too narrow, the start is
// cut with an ellipsis and the last group of the identifier stays whole.
const addressCut = story.address.lastIndexOf("-");
const addressStart = story.address.slice(0, addressCut);
const addressEnd = story.address.slice(addressCut);

// The form of the story as the studio's site writes it, one list of colored parts per line.
type Part = readonly [kind: "mark" | "tag" | "attribute" | "string" | "address" | "text", text: string];
const snippet: ReadonlyArray<ReadonlyArray<Part>> = [
  [["mark", "<"], ["tag", "form"]],
  [["text", "  "], ["attribute", "action"], ["mark", '="'], ["address", story.address], ["mark", '"']],
  [["text", "  "], ["attribute", "method"], ["mark", "="], ["string", '"post"']],
  [["mark", ">"]],
  ...(
    [
      ["input", "text", "name"],
      ["input", "email", "email"],
    ] as const
  ).map(
    ([tag, type, name]): ReadonlyArray<Part> => [
      ["text", "  "],
      ["mark", "<"],
      ["tag", tag],
      ["text", " "],
      ["attribute", "type"],
      ["mark", "="],
      ["string", `"${type}"`],
      ["text", " "],
      ["attribute", "name"],
      ["mark", "="],
      ["string", `"${name}"`],
      ["text", " "],
      ["attribute", "required"],
      ["mark", " />"],
    ],
  ),
  [
    ["text", "  "],
    ["mark", "<"],
    ["tag", "textarea"],
    ["text", " "],
    ["attribute", "name"],
    ["mark", "="],
    ["string", '"message"'],
    ["text", " "],
    ["attribute", "required"],
    ["mark", "></"],
    ["tag", "textarea"],
    ["mark", ">"],
  ],
  [
    ["text", "  "],
    ["mark", "<"],
    ["tag", "button"],
    ["text", " "],
    ["attribute", "type"],
    ["mark", "="],
    ["string", '"submit"'],
    ["mark", ">"],
    ["text", "Send"],
    ["mark", "</"],
    ["tag", "button"],
    ["mark", ">"],
  ],
  [["mark", "</"], ["tag", "form"], ["mark", ">"]],
];
const partTones = {
  mark: "text-subtle",
  tag: "font-semibold text-foreground",
  attribute: "text-muted",
  string: "text-brand",
  address: "text-brand",
  text: "text-foreground",
} as const;

// A text of the form page edited in place: the field is wider than the column by its
// padding, so its text stays on the column, and it shows when pointed at or focused.
const inPlace =
  "ui-field -mx-3 w-[calc(100%+1.5rem)] min-w-0 px-3 text-left @md:-mx-4 @md:w-[calc(100%+2rem)] @md:px-4";
const hint = "m-0 text-xs text-pretty text-ui-muted-foreground";
// The dashboard's Button: its base, then its default, outline and ghost variants.
const button =
  "ui-button inline-flex shrink-0 items-center justify-center gap-1.5 rounded-ui font-medium whitespace-nowrap select-none";
const primaryButton = `${button} border border-ui-border bg-ui-primary text-ui-primary-foreground shadow-ui hover:bg-ui-primary/90`;
const outlineButton = `${button} border border-ui-border bg-ui-muted text-ui-foreground shadow-ui hover:bg-ui-primary hover:text-ui-primary-foreground`;
const ghostButton = `${button} text-ui-muted-foreground hover:bg-ui-primary hover:text-ui-primary-foreground`;
// Its sm size looks 32px high; the pseudo-element keeps the target at 40px.
const small = "relative h-8 px-3 text-xs before:absolute before:inset-x-0 before:-inset-y-1";
const tableHead = "pb-1 text-xs font-medium text-ui-muted-foreground";
const groupHead =
  "border-b border-ui-border/70 pt-4 pb-1.5 text-left text-xs font-medium text-ui-muted-foreground";
const studioField = "studio-field mt-1.5 flex min-h-10 items-center px-3 py-2 text-[0.9375rem]";
// The dashboard's Badge: its base, then its neutral and success variants.
const badge =
  "inline-flex h-5.5 shrink-0 items-center gap-1.5 justify-self-end rounded-full border px-2.5 text-xs font-medium whitespace-nowrap";
const neutralBadge = `${badge} border-ui-border bg-ui-muted text-ui-muted-foreground`;
const successBadge = `${badge} border-ui-success/30 bg-ui-success-subtle text-ui-success`;
const deliveryIcon =
  "mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-ui-muted text-ui-muted-foreground";
---

<style is:inline set:html={dashboardThemeCss(dashboardStylesheet)}></style>

<section class="lifecycle" aria-labelledby="message-path" data-lifecycle>
  <div class="max-w-2xl">
    <h2
      id="message-path"
      class="m-0 text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.025em] text-balance text-foreground"
    >
      Message lifecycle
    </h2>
    <p class="mt-4 mb-0 text-lg leading-[1.6] text-pretty text-muted">{lifecycleIntro}</p>
  </div>

  <div class="mt-14">
    <Stage {...step("create")}>
      <Frame
        dashboard
        location={story.instance}
        icon="lock"
        owner={dashboard}
      >
        <div class="flex h-12 items-center gap-1 border-b border-ui-border pr-3 pl-1">
          <span class="grid size-8 place-items-center text-ui-muted-foreground">
            <Icon name="panel-left" />
          </span>
          <p class="m-0 flex min-w-0 flex-1 items-center gap-2 px-1 text-sm text-ui-muted-foreground">
            <span class="shrink-0">{text.forms}</span>
            <span>/</span>
            <span class="swap swap-inline text-ui-foreground" data-swap="title">
              <span data-alt="a" inert>{text.formPage.newTitle}</span>
              <span data-alt="b">{form.name}</span>
            </span>
          </p>
        </div>
        <div class="px-5 pt-6 pb-8 @md:px-8">
          <div class="-ml-3 flex h-16 w-18 items-center justify-center text-5xl leading-none @md:-ml-4 @md:w-20">
            {form.emoji}
          </div>
          <button
            type="button"
            class:list={[inPlace, "mt-2 flex h-12 items-center rounded-ui text-2xl font-semibold tracking-[-0.035em] @md:text-3xl"]}
            aria-label={`${text.formPage.name}: ${form.name}`}
            data-part="name"
            data-control
            disabled
          >
            <span data-type>{form.name}</span>
          </button>
          <button
            type="button"
            class:list={[inPlace, "mt-1 block rounded-ui-xs py-2 text-sm text-pretty text-ui-muted-foreground"]}
            aria-label={`${text.formPage.business}: ${form.business}`}
            data-part="business"
            data-control
            disabled
          >
            <span class="relative block">
              <span data-type>{form.business}</span>
              <span class="type-placeholder" aria-hidden="true">{text.formPage.businessPlaceholder}</span>
            </span>
          </button>
          <div data-part="settings" data-reveal>
            <div class="mt-7 grid gap-5">
              <div class="grid gap-x-6 gap-y-1.5 @md:grid-cols-[9.5rem_minmax(0,1fr)]">
                <p class="m-0 flex items-center text-sm leading-none font-medium @md:h-10">
                  {text.formPage.address}
                </p>
                <div class="grid min-w-0 grid-cols-1 gap-1.5">
                  <div
                    class="address-field flex min-h-10 items-center gap-2 rounded-ui border border-ui-border bg-ui-input py-1 pr-1 pl-4"
                    data-part="address"
                  >
                    <span
                      class="flex min-w-0 flex-1 font-ui-mono whitespace-nowrap *:text-[0.625rem] @md:*:text-[0.6875rem]"
                    >
                      <span class="truncate">{addressStart}</span><span class="shrink-0">{addressEnd}</span>
                    </span>
                    <button
                      type="button"
                      class:list={[ghostButton, "swap relative size-8 place-items-center before:absolute before:-inset-1"]}
                      aria-label={text.formPage.copy}
                      data-swap="copy"
                      data-part="copy"
                      data-control="connect"
                      data-first="copy"
                      disabled
                    >
                      <span data-alt="a" class="inline-flex" inert><Icon name="copy" /></span>
                      <span data-alt="b" class="inline-flex text-ui-success"><Icon name="check" /></span>
                    </button>
                  </div>
                  <p class={hint}>{text.formPage.addressHint}</p>
                </div>
              </div>
              <div class="grid gap-x-6 gap-y-1.5 @md:grid-cols-[9.5rem_minmax(0,1fr)]">
                <p class="m-0 flex items-center text-sm leading-none font-medium @md:h-10">
                  {text.formPage.status}
                </p>
                <div class="flex min-h-10 items-center">
                  <span class="inline-flex h-5.5 shrink-0 items-center gap-1.5 rounded-full border border-ui-success/30 bg-ui-success-subtle px-2.5 text-xs font-medium whitespace-nowrap text-ui-success">
                    <span class="size-1.5 rounded-full bg-current"></span>
                    {text.formPage.active}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Frame>
    </Stage>

    <Stage {...step("connect")}>
      <Flux slot="flux" chips={[{ icon: "copy", label: story.address }]} code />
      <Frame
        location="contact.html"
        icon="globe"
        owner="The code of your site"
      >
        <div class="px-5 py-5 font-ui-mono text-[0.8125rem] leading-[1.75] wrap-anywhere whitespace-pre-wrap">
          {
            snippet.map((line) => (
              <div>
                {line.map(([kind, text]) =>
                  kind === "address" ? (
                    <span class="snippet-address" data-part="address"><span data-type>{text}</span></span>
                  ) : (
                    <span class={partTones[kind]}>{text}</span>
                  ),
                )}
              </div>
            ))
          }
        </div>
      </Frame>
    </Stage>

    <Stage {...step("submit")}>
      <Flux
        slot="flux"
        chips={[{ icon: "globe", label: `Published on ${story.site.split("/")[0]}` }]}
      />
      <p slot="note" class="mt-3 mb-0 text-sm text-pretty text-subtle" data-scripted hidden>
        Send again to follow another message.
      </p>
      <Frame
        location={story.site}
        icon="lock"
        owner="Your site"
      >
        <div class="studio px-6 pt-7 pb-8">
          <p class="studio-title m-0">Write to the studio</p>
          <p class="mt-1.5 mb-0 text-sm text-muted">
            Workshops, orders and commissions. We answer within two days.
          </p>
          <div class="mt-6 grid gap-4">
            {
              messages.map(({ id, sender, text: written }, index) => (
                <div class="grid gap-4" data-message={id} hidden={index > 0}>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <span class="studio-label">Name</span>
                      <div class={studioField} data-part="name">
                        <span data-type>{sender.name}</span>
                      </div>
                    </div>
                    <div>
                      <span class="studio-label">Email</span>
                      <div class={studioField} data-part="email">
                        <span class="min-w-0 truncate" data-type>{sender.email}</span>
                      </div>
                    </div>
                  </div>
                  <div>
                    <span class="studio-label">Message</span>
                    <div class:list={[studioField, "min-h-32 items-start leading-[1.6]"]} data-part="message">
                      <span data-type>{written}</span>
                    </div>
                  </div>
                </div>
              ))
            }
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <button
                type="button"
                class="ui-button studio-button"
                data-part="send"
                data-control
                data-next
                disabled
              >
                <span class="swap swap-inline" data-swap="send">
                  <span data-alt="a" inert>Send</span>
                  <span data-alt="b" class="inline-flex items-center gap-1.5">
                    <Icon name="check" class="size-3.5" />Sent
                  </span>
                </span>
              </button>
              {
                messages.map(({ id, sender }, index) => (
                  <span
                    class="text-sm text-muted"
                    data-part="thanks"
                    data-reveal
                    data-message={id}
                    hidden={index > 0}
                  >
                    Thanks {sender.name}, your message is on its way.
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </Frame>
    </Stage>

    <Stage {...step("reception")}>
      <Flux slot="flux" chips={[{ icon: "send", label: `POST ${story.shortAddress}` }]} code />
      <Frame
        dashboard
        location={story.instance}
        icon="lock"
        owner={dashboard}
      >
        <div class="grid gap-4 px-5 pt-5 pb-6">
          {
            messages.map(({ id, sender }, index) => (
              <div class="grid gap-1 border-b border-ui-border pb-4" data-message={id} hidden={index > 0}>
                <p class="m-0 text-xl/snug font-semibold">{sender.name}</p>
                <p class="m-0 text-sm text-ui-muted-foreground">{sender.email}</p>
              </div>
            ))
          }
          <div class="flex min-h-8 items-center justify-between gap-3">
            <p class="m-0 text-sm font-semibold">{text.classification.title}</p>
            <button type="button" class:list={[ghostButton, small, "-mr-1"]} data-control disabled>
              <Icon name="flask-conical" class="size-3.5" />
              {text.classification.test}
            </button>
          </div>
          <div class="swap" data-swap="verdict">
            <p data-alt="a" inert class="m-0 text-sm/relaxed text-ui-muted-foreground">
              {text.reception.received}.
            </p>
            <p data-alt="b" class="m-0 text-sm/relaxed text-pretty">
              <span class="font-medium">{text.classification.analyzing}.</span>{" "}
              <span class="text-ui-muted-foreground">{text.classification.analyzingDetail}</span>
            </p>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr>
                <th scope="col" class:list={[tableHead, "text-left"]}>
                  {text.classification.check}
                </th>
                <th scope="col" class:list={[tableHead, "pl-3 text-right whitespace-nowrap"]}>
                  {text.classification.onArrival}
                </th>
              </tr>
              <tr>
                <th scope="colgroup" colspan="2" class={groupHead}>
                  {text.classification.reception}
                </th>
              </tr>
            </thead>
            {text.reception.checks.map((check) => <CheckRow {...check} />)}
          </table>
        </div>
      </Frame>
    </Stage>

    <Stage {...step("analysis")}>
      <Flux slot="flux" chips={[{ icon: "scan-text", label: text.analysis.sent }]} />
      <Frame
        dashboard
        location={story.instance}
        icon="lock"
        owner={dashboard}
      >
        <div class="grid gap-4 px-5 pt-5 pb-6">
          <div class="flex min-h-8 items-center justify-between gap-3">
            <p class="m-0 text-sm font-semibold">{text.classification.title}</p>
            <button type="button" class:list={[ghostButton, small, "-mr-1"]} data-control disabled>
              <Icon name="flask-conical" class="size-3.5" />
              {text.classification.test}
            </button>
          </div>
          {
            messages.map(({ id, scores }, index) => (
              <div class="grid gap-4" data-message={id} hidden={index > 0}>
                <div class="swap" data-swap="verdict">
                  <p data-alt="a" inert class="m-0 text-sm/relaxed text-pretty">
                    <span class="font-medium">{text.classification.analyzing}.</span>{" "}
                    <span class="text-ui-muted-foreground">{text.classification.analyzingDetail}</span>
                  </p>
                  <p data-alt="b" class="m-0 text-sm/relaxed text-pretty">
                    <span class="font-medium">{text.analysis.verdicts[id].title}.</span>{" "}
                    <span class="text-ui-muted-foreground">{text.analysis.verdicts[id].detail}</span>
                  </p>
                </div>
                <table class="w-full text-sm">
                  <thead>
                    <tr>
                      <th scope="col" class:list={[tableHead, "text-left"]}>
                        {text.classification.check}
                      </th>
                      <th scope="col" class:list={[tableHead, "pl-3 text-right whitespace-nowrap"]}>
                        {text.classification.onArrival}
                      </th>
                    </tr>
                    <tr>
                      <th scope="colgroup" colspan="2" class={groupHead}>
                        <span class="flex items-baseline justify-between gap-3">
                          {text.classification.aiAnalysis}
                          <span class="font-normal">{text.classification.model}</span>
                        </span>
                      </th>
                    </tr>
                  </thead>
                  <CheckRow
                    icon="mail-warning"
                    name={text.analysis.spam}
                    meter={{
                      id: `lifecycle-${id}-spam`,
                      score: scores.spam,
                      zones: [
                        { from: thresholds.possibleSpam, to: thresholds.probableSpam, strong: false },
                        { from: thresholds.probableSpam, to: 1, strong: true },
                      ],
                      ticks: [thresholds.possibleSpam, thresholds.probableSpam],
                    }}
                  />
                  <CheckRow
                    icon="megaphone"
                    name={text.analysis.solicitation}
                    meter={{
                      id: `lifecycle-${id}-solicitation`,
                      score: scores.solicitation,
                      zones: [{ from: thresholds.solicitation, to: 1, strong: true }],
                      ticks: [thresholds.solicitation],
                    }}
                  />
                  <CheckRow
                    icon="target"
                    name={text.analysis.relevance}
                    meter={{
                      id: `lifecycle-${id}-relevance`,
                      score: scores.relevance,
                      zones: [{ from: 0, to: thresholds.relevance, strong: true }],
                      ticks: [thresholds.relevance],
                    }}
                  />
                </table>
              </div>
            ))
          }
        </div>
      </Frame>
    </Stage>

    <Stage {...step("outcome")}>
      <Flux
        slot="flux"
        chips={[
          { icon: "megaphone", label: outcome.review.sent, message: "review" },
          { icon: "check", label: outcome.accepted.sent, message: "accepted" },
        ]}
      />
      <Frame
        dashboard
        location={story.instance}
        icon="lock"
        owner={dashboard}
      >
        {
          messages.map(({ id, sender, text: written, receivedAt }, index) => (
            <div data-message={id} hidden={index > 0}>
              <div class="flex h-14 items-center gap-2 border-b border-ui-border pr-3 pl-1">
                <span class="grid size-8 shrink-0 place-items-center text-ui-muted-foreground">
                  <Icon name="panel-left" />
                </span>
                <p class="m-0 min-w-0 flex-1 truncate text-base font-semibold">
                  {outcome[id].folder}
                  <span
                    class="swap swap-inline ml-2 text-sm font-normal text-ui-muted-foreground tabular-nums"
                    data-swap="count"
                  >
                    <span data-alt="a" inert>0</span>
                    <span data-alt="b">1</span>
                  </span>
                </p>
                {
                  id === "review" && (
                    <span class="flex shrink-0 items-center gap-2" data-part="actions" data-reveal>
                      <button
                        type="button"
                        class:list={[outlineButton, small]}
                        data-control
                        data-first="decide"
                        disabled
                      >
                        <Icon name="archive" class="size-3.5" />
                        {outcome.review.archive}
                      </button>
                      <button
                        type="button"
                        class:list={[primaryButton, small]}
                        data-control
                        data-first="decide"
                        disabled
                      >
                        <Icon name="check" class="size-3.5" />
                        <span class="@max-md:hidden">{outcome.review.acceptAndSend}</span>
                        <span class="@md:hidden">{outcome.review.accept}</span>
                      </button>
                    </span>
                  )
                }
              </div>
              <div class="min-h-24">
                <div
                  class="flex w-full gap-3 border-l-3 border-l-ui-primary bg-ui-primary/10 px-4 py-3"
                  data-part="row"
                  data-reveal
                >
                  <span class="grid min-w-0 flex-1 grid-cols-1 gap-1">
                    <span class="flex items-baseline justify-between gap-3">
                      <span class="truncate text-sm font-medium">{sender.name}</span>
                      <span class="shrink-0 text-xs text-ui-muted-foreground tabular-nums">
                        {receivedAt}
                      </span>
                    </span>
                    <span class="line-clamp-2 text-sm wrap-anywhere text-ui-muted-foreground">
                      {written}
                    </span>
                    <span class="flex items-center gap-2 text-xs text-ui-muted-foreground">
                      {
                        id === "review" && (
                          <span class="inline-flex shrink-0 items-baseline gap-1 font-medium text-ui-warning">
                            <Icon name="megaphone" class="size-3.5 self-center" />
                            <span class="text-xs">{outcome.review.reason}</span>
                          </span>
                        )
                      }
                      <span class="truncate text-xs">{form.name}</span>
                    </span>
                  </span>
                </div>
              </div>
              {
                id === "accepted" && (
                  <div class="border-t border-ui-border bg-ui-card" data-part="deliveries" data-reveal>
                    <div class="flex h-11 items-center gap-2 pr-3 pl-5">
                      <p class="m-0 min-w-0 flex-1 text-sm font-semibold">{outcome.accepted.deliveries}</p>
                      <button
                        type="button"
                        class:list={[ghostButton, "relative size-8 before:absolute before:-inset-1"]}
                        aria-label={outcome.accepted.refresh}
                        data-control
                        data-only="deliver"
                        disabled
                      >
                        <Icon name="refresh-cw" class="size-4" />
                      </button>
                    </div>
                    <ul class="m-0 list-none divide-y divide-ui-border px-5 pt-1 pb-6">
                      <li class="m-0 flex items-start gap-3 py-3 first:pt-1 last:pb-0" data-delivery>
                        <span class={deliveryIcon}>
                          <Icon name="mail" class="size-3.5" />
                        </span>
                        <div class="flex min-w-0 flex-1 flex-wrap items-center justify-between gap-x-3 gap-y-1">
                          <p class="m-0 min-w-0 flex-1 basis-44 text-sm font-medium wrap-anywhere">
                            {outcome.accepted.email}
                          </p>
                          <span class="swap" data-swap="status">
                            <span data-alt="a" inert class={neutralBadge}>{outcome.accepted.sending}</span>
                            <span data-alt="b" class={successBadge}>{outcome.accepted.delivered}</span>
                          </span>
                        </div>
                      </li>
                      <li class="m-0 flex items-start gap-3 py-3 first:pt-1 last:pb-0" data-delivery>
                        <span class={deliveryIcon}>
                          <Icon name="webhook" class="size-3.5" />
                        </span>
                        <div class="flex min-w-0 flex-1 flex-wrap items-center justify-between gap-x-3 gap-y-1">
                          <p class="m-0 min-w-0 flex-1 basis-44 text-sm font-medium wrap-anywhere">
                            {outcome.accepted.webhook}
                            <span class="ml-1 font-ui-mono text-xs font-normal text-ui-muted-foreground">
                              {story.destinations.webhook}
                            </span>
                          </p>
                          <span class="swap" data-swap="status">
                            <span data-alt="a" inert class={neutralBadge}>{outcome.accepted.sending}</span>
                            <span data-alt="b" class={successBadge}>{outcome.accepted.delivered}</span>
                          </span>
                        </div>
                      </li>
                    </ul>
                  </div>
                )
              }
            </div>
          ))
        }
      </Frame>
    </Stage>
  </div>
</section>

<script>
  import { direct } from "./director.ts";

  for (const lifecycle of document.querySelectorAll<HTMLElement>("[data-lifecycle]")) {
    direct(lifecycle);
  }
</script>
