    "astro": "catalog:",
    "emdash": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "@emdash-cms/plugin-forms": ">=0.2.13",
    "astro": ">=7.0.0",
    "emdash": ">=1.5.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@emdash-cms/plugin-forms": {
      "optional": true
    }
  }
}
