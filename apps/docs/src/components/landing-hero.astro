---
// Starlight renders this component instead of the page title on a page with `hero` in its
// frontmatter. Only the landing page has one: its first screen is the pitch, the Deploy to
// Cloudflare button, and the agent prompt card with overlapping harness logos.
import { Code } from "@astrojs/starlight/components";
import antigravityIcon from "@lobehub/icons-static-svg/icons/antigravity-color.svg?raw";
import claudeCodeIcon from "@lobehub/icons-static-svg/icons/claudecode-color.svg?raw";
import codexIcon from "@lobehub/icons-static-svg/icons/codex-color.svg?raw";
import cursorIcon from "@lobehub/icons-static-svg/icons/cursor.svg?raw";
import openaiIcon from "@lobehub/icons-static-svg/icons/openai.svg?raw";
import opencodeIcon from "@lobehub/icons-static-svg/icons/opencode.svg?raw";
import typesafeAiIcon from "@lobehub/icons-static-svg/icons/typesafeai.svg?raw";
import { ContainerSection } from "lucode-starlight/components";

import { agentPrompt, deployUrl } from "../landing.ts";

const { hero } = Astro.locals.starlightRoute.entry.data;
const title = hero?.title ?? "";

const harnesses = [
  { name: "Claude Code", svg: claudeCodeIcon },
  { name: "OpenAI Codex", svg: codexIcon },
  { name: "Cursor", svg: cursorIcon },
  { name: "OpenCode", svg: opencodeIcon },
  { name: "Antigravity", svg: antigravityIcon },
];
---

<ContainerSection width="xl">
  <section
    class="grid gap-10 pt-10 pb-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1.05fr)] lg:items-center lg:gap-14 lg:pt-16"
    aria-labelledby="_top"
  >
    <div>
      <h1
        id="_top"
        data-page-title
        class="m-0 text-[clamp(2.25rem,1.6rem+2.6vw,3.5rem)] leading-[1.05] font-bold tracking-[-0.03em] text-balance text-foreground"
      >
        {title}
      </h1>
      <p class="mt-6 max-w-[38rem] text-lg leading-[1.65] text-muted">
        Rondyr is a form backend with spam filtering powered by <strong>classifier models</strong> like{" "}
        <span class="inline-flex items-center gap-[0.3em] align-bottom text-lg leading-[1.65] font-medium whitespace-nowrap text-foreground">
          <span
            class="inline-flex size-[1.15em] items-center justify-center rounded-[0.25em] bg-[#e551ba] text-[#1e1e1e] [&>svg]:size-[0.8em]"
            aria-hidden="true"
          >
            <Fragment set:html={typesafeAiIcon} />
          </span>
          <span>Jev</span>
        </span>{" "}
        or{" "}
        <span class="inline-flex items-center gap-[0.3em] align-bottom text-lg leading-[1.65] font-medium whitespace-nowrap text-foreground">
          <span class="inline-flex items-center [&>svg]:size-[1em]" aria-hidden="true">
            <Fragment set:html={openaiIcon} />
          </span>
          <span>OpenAI Decisions</span>
        </span>{" "}
        that runs in your own Cloudflare account. Point your site's{" "}
        <code class="rounded-[0.3em] bg-surface px-[0.3em] py-[0.1em] text-[0.95em]">&lt;form&gt;</code>{" "}
        at it, and Rondyr saves every message before screening it for spam, sales pitches, and
        relevance to your business. Anything doubtful waits in quarantine until you accept or
        archive it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          class="inline-flex rounded-md focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand"
          href={deployUrl}
        >
          <img
            class="block h-10 w-auto"
            src="https://deploy.workers.cloudflare.com/button"
            alt="Deploy to Cloudflare"
            width="165"
            height="32"
          />
        </a>
        <a
          class="inline-flex min-h-11 items-center font-medium text-foreground underline decoration-brand underline-offset-[0.3em] hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand"
          href="/deployment/"
        >
          Read the deployment guide
        </a>
      </div>
      <p class="mt-6 max-w-[38rem] border-l-[3px] border-brand pl-4 text-[0.9375rem] leading-[1.6] text-subtle [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:decoration-brand [&_a]:underline-offset-[0.2em] [&_strong]:text-foreground">
        Rondyr needs <strong>Workers Paid</strong>, at least $5 a month per Cloudflare account. On
        Workers Free, sign-in can fail and free daily limits run out quickly.{" "}
        <a href="/costs/">Costs and limits</a>
      </p>
      <p class="mt-6 max-w-[38rem] border-l-[3px] border-brand pl-4 text-[0.9375rem] leading-[1.6] text-subtle [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:decoration-brand [&_a]:underline-offset-[0.2em] [&_strong]:text-foreground">
        Prefer to deploy from a fork with Alchemy and GitHub Actions, on your own domain?{" "}
        <a href="/deployment/#deploy-with-alchemy-and-github-actions">Deploy with Alchemy</a>
      </p>
    </div>

    <div class="min-w-0 p-5 sm:p-6">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <div
          class="inline-flex items-center pr-[0.45rem]"
          aria-label="Works with Claude Code, OpenAI Codex, Cursor, OpenCode, and Antigravity"
        >
          {
            harnesses.map((harness) => (
              <span
                class="-mr-[0.45rem] inline-flex size-[1.9rem] items-center justify-center rounded-full border-2 border-surface bg-background text-foreground [&>svg]:block [&>svg]:size-[1.05rem]"
                title={harness.name}
                aria-hidden="true"
              >
                <Fragment set:html={harness.svg} />
              </span>
            ))
          }
        </div>
        <h2 class="m-0 text-[0.9375rem] font-semibold text-foreground">
          <button
            type="button"
            data-copy-prompt={agentPrompt}
            class="group inline-flex cursor-pointer items-center gap-1.5 rounded-sm bg-transparent p-0 text-left text-[0.9375rem] font-semibold text-foreground transition-colors hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand"
          >
            <span data-copy-label>Or copy this prompt for your agent</span>
            <svg
              data-copy-icon
              class="size-3.5 shrink-0 text-subtle transition-colors group-hover:text-brand"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg
              data-copied-icon
              class="hidden size-3.5 shrink-0 text-brand"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </h2>
      </div>

      <Code code={agentPrompt} lang="markdown" title="prompt.md" class="agent-code min-w-0" />
    </div>
  </section>
</ContainerSection>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]")) {
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const copyIcon = button.querySelector<SVGElement>("[data-copy-icon]");
    const copiedIcon = button.querySelector<SVGElement>("[data-copied-icon]");
    const defaultLabel = label?.textContent ?? "Or copy this prompt for your agent";
    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      const prompt = button.dataset["copyPrompt"];
      if (!prompt) return;

      try {
        await navigator.clipboard.writeText(prompt);
      } catch {
        const fallback = button
          .closest("div")
          ?.parentElement?.querySelector<HTMLButtonElement>(".expressive-code .copy button");
        if (!fallback) return;
        fallback.click();
      }

      if (label) label.textContent = "Prompt copied";
      copyIcon?.classList.add("hidden");
      copiedIcon?.classList.remove("hidden");

      if (resetTimer !== undefined) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        if (label) label.textContent = defaultLabel;
        copiedIcon?.classList.add("hidden");
        copyIcon?.classList.remove("hidden");
      }, 2000);
    });
  }
</script>

<style>
  .agent-code :global(.expressive-code pre),
  .agent-code :global(.expressive-code .ec-line .code) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .agent-code :global(.expressive-code .copy button) {
    opacity: 0.85;
  }

  .agent-code :global(.expressive-code .copy button:hover),
  .agent-code :global(.expressive-code .copy button:focus-visible) {
    opacity: 1;
  }
</style>
