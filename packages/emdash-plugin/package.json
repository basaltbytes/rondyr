{
  "name": "@basaltbytes/emdash-plugin-rondyr",
  "version": "0.1.0",
  "description": "EmDash plugin that sends form submissions to Rondyr and shows its inbox in the EmDash admin",
  "keywords": [
    "astro",
    "emdash",
    "emdash-plugin",
    "forms",
    "rondyr",
    "spam-filter"
  ],
  "homepage": "https://github.com/basaltbytes/rondyr/blob/main/docs/emdash.md",
  "bugs": {
    "url": "https://github.com/basaltbytes/rondyr/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/rondyr.git",
    "directory": "packages/emdash-plugin"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./forms": "./src/forms-plugin.ts",
    "./forms-with-submissions": "./src/forms-with-submissions.ts",
    "./admin": "./src/admin.tsx",
    "./route": "./src/route.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/kumo": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@emdash-cms/plugin-forms": "catalog:",
