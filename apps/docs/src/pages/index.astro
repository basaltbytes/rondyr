---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import { ContainerSection } from "lucode-starlight/components";

import { firstRun, formSnippet } from "../landing.ts";
import { pageRoute } from "../repository/documents.ts";
import { sidebar } from "../sidebar.ts";

const titles = new Map((await getCollection("docs")).map(({ id, data }) => [id, data.title]));
const groups = sidebar.map(({ label, items }) => ({
  label,
  pages: items.map(({ slug, label: pageLabel }) => ({
    href: pageRoute(slug),
    title: pageLabel ?? titles.get(slug) ?? slug,
  })),
}));
---

<StarlightPage
  frontmatter={{
    title: "Rondyr",
    head: [{ tag: "title", content: "Rondyr: a form backend with spam filtering for Cloudflare" }],
    description:
      "Rondyr is a form backend with spam filtering that you deploy to your own Cloudflare account. Doubtful messages wait in quarantine for a person to decide.",
    template: "splash",
    hero: {
      title: "The gatekeeper for your forms.",
      tagline:
        "Rondyr is a form backend with spam filtering that runs in your own Cloudflare account. Point your site's <code>&lt;form&gt;</code> at it, and Rondyr saves every message before screening it with a classifier model (Jev or OpenAI Decisions) for spam, sales pitches, and relevance to your business. Anything doubtful waits in quarantine until you accept or archive it.",
      actions: [],
    },
  }}
>
  <ContainerSection width="xl">
    <div class="landing not-content">
      <section class="first-run" aria-labelledby="first-run-heading">
        <h2 id="first-run-heading">First run</h2>
        <ol>
          {
            firstRun.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p set:html={step.html} />
              </li>
            ))
          }
        </ol>
      </section>

      <section class="form-section" aria-labelledby="form-on-your-site">
        <div class="form-text">
          <h2 id="form-on-your-site">The form on your site</h2>
          <p>
            Replace the address with your Rondyr host, and the ID with the one shown in <strong>Forms</strong>.
            A regular HTML form shows a confirmation page or redirects visitors to your own thank-you page.
            The same URL accepts JSON from <code>fetch</code> when you want to submit without leaving the page.
          </p>
          <p><a href="/forms/">Put a form on your site</a></p>
        </div>
        <div class="form-code">
          <Code code={formSnippet} lang="html" title="contact.html" />
        </div>
      </section>

      <section aria-labelledby="message-path">
        <h2 id="message-path">Message lifecycle</h2>
        <dl class="path">
          <div>
            <dt>Saved first</dt>
            <dd>
              Every submission is saved in your Cloudflare account before Rondyr answers your site, so a
              temporary outage doesn't drop messages.
            </dd>
          </div>
          <div>
            <dt>Screened for spam</dt>
            <dd>
              Jev on Workers AI or the OpenAI Decisions API scores each message for spam, unsolicited
              sales pitches, and (if you describe your business) whether it relates to what you do. You
              pick the model for your instance and can optionally use the second one for uncertain
              messages.
            </dd>
          </div>
          <div>
            <dt>Quarantined, not deleted</dt>
            <dd>
              Probable spam, uncertain messages, sales pitches, off-topic notes, and analysis errors wait
              in <strong>To review</strong> with a plain reason until a person decides.
            </dd>
          </div>
          <div>
            <dt>Forwarded automatically</dt>
            <dd>
              Accepted messages go out by <a href="/email/">email</a> (through Resend or Cloudflare Email
              Sending) or to <a href="/webhooks/">signed webhooks</a>. With the <a href="/emdash/">EmDash plugin</a>,
              editors review messages right inside EmDash.
            </dd>
          </div>
          <div>
            <dt>Owned by you</dt>
            <dd>
              Your messages stay in your Cloudflare account. They leave only in the emails, webhooks, and
              exports you configure.
            </dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="documentation">
        <h2 id="documentation">Documentation</h2>
        <div class="docs-index">
          {
            groups.map((group) => (
              <div>
                <h3>{group.label}</h3>
                <ul>
                  {group.pages.map((page) => (
                    <li>
                      <a href={page.href}>{page.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </ContainerSection>
</StarlightPage>

<style>
  .landing {
    display: grid;
    gap: calc(var(--spacing) * 16);
    padding-block-end: calc(var(--spacing) * 16);
  }

  h2 {
    margin: 0 0 calc(var(--spacing) * 6);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--foreground);
  }

  p,
  dd {
    line-height: 1.65;
    color: var(--gray-2);
  }

  code {
    font-size: 0.9em;
    padding: 0.1em 0.3em;
    border-radius: 0.3em;
    background: var(--gray-7);
  }

  a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--rondyr-accent);
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--rondyr-accent);
  }

  .first-run {
    padding-block-start: calc(var(--spacing) * 12);
    border-block-start: 1px solid var(--border);
  }

  .first-run ol {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--spacing) * 8);
  }

  @media (min-width: 64rem) {
    .first-run ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(var(--spacing) * 10);
    }
  }

  .first-run li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: calc(var(--spacing) * 3);
    align-content: start;
  }

  .first-run li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1.5px solid var(--rondyr-accent);
    color: var(--rondyr-accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .first-run h3 {
    margin: 0;
    align-self: center;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--foreground);
  }

  .first-run li p {
    margin: calc(var(--spacing) * 2) 0 0;
  }

  .form-section {
    display: grid;
    gap: calc(var(--spacing) * 6) calc(var(--spacing) * 12);
    padding-block-start: calc(var(--spacing) * 12);
    border-block-start: 1px solid var(--border);
  }

  @media (min-width: 64rem) {
    .form-section {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }

  .form-text p + p {
    margin-block-start: calc(var(--spacing) * 4);
  }

  .form-code {
    min-width: 0;
  }

  .path {
    display: grid;
    gap: calc(var(--spacing) * 8) calc(var(--spacing) * 10);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .path {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .path > div {
    padding-block-start: calc(var(--spacing) * 4);
    border-block-start: 2px solid var(--foreground);
  }

  dt {
    font-weight: 600;
    color: var(--foreground);
  }

  dd {
    margin: calc(var(--spacing) * 2) 0 0;
  }

  .docs-index {
    display: grid;
    gap: calc(var(--spacing) * 8);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }

  h3 {
    margin: 0 0 calc(var(--spacing) * 3);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--spacing) * 2);
  }
</style>
