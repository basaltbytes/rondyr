# Immutable hashed assets built by Astro and Vite.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Search index and social card image.
/pagefind/*
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

# Crawler and LLM discovery files.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/llms-full.txt
  Cache-Control: public, max-age=3600

# Per-page Markdown mirrors for AI agents (search engines keep canonical ranking on HTML).
/*.md
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex, follow

# Never index the error page.
/404.html
  X-Robots-Tag: noindex, follow

# Baseline security headers and agent discovery signals on all routes.
/*
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  Link: </llms.txt>; rel="alternate"; type="text/markdown", </llms-full.txt>; rel="describedby"; type="text/markdown"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
