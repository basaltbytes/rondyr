# Generate independently with openssl rand -hex 32.
BETTER_AUTH_SECRET=
# Set only while creating the first operator account. Use a different secret.
# RONDYR_SETUP_TOKEN=
# Encrypts webhook signing secrets in D1. Generate it with openssl rand -base64 32.
# Without it, webhook destinations cannot be created or rotated.
# RONDYR_SECRETS_KEY=
# For a remote stage, use its canonical HTTPS origin.
# BETTER_AUTH_URL=https://rondyr-staging.your-subdomain.workers.dev
# Select jev (default) or openai when deploying with Alchemy. openai calls the AI Gateway
# named default, which Cloudflare creates on the first request.
# RONDYR_CLASSIFIER=jev
