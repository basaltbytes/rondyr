{
  "name": "rondyr",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:alchemy": "pnpm build && alchemy dev --config alchemy-run.ts --stage local",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "pnpm build && alchemy deploy --config alchemy-run.ts",
    "deploy:plan": "pnpm build && alchemy plan --config alchemy-run.ts",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run && node scripts/worker-budget.mjs",
    "cf:types": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate --config drizzle-config.ts",
    "db:check": "drizzle-kit check --config drizzle-config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm cf:types && effect-tsgo tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "knip": "knip",
    "doctor": "node scripts/doctor.mjs",
    "evaluate": "node evals/cli.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:lint && pnpm knip && pnpm db:check && pnpm run doctor",
    "test:lint": "node --test \"tooling/oxlint/**/*.test.mjs\""
  },
  "dependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@base-ui/react": "1.9.0",
    "better-auth": "1.7.26",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@babel/core": "8.1.2",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@effect/platform-node": "4.1.4",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "alchemy": "2.0.0-beta.87",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "knip": "6.46.1",
    "miniflare": "5.20261118.0-beta",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@11.28.9"
}
