{
  "name": "@rondyr/oxlint",
  "version": "0.0.0",
  "private": true,
  "description": "Rondyr's local Oxlint rules, loaded as a JS plugin by the root .oxlintrc.json.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit",
    "test": "node --test \"rules/*.test.mjs\" \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@rondyr/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
