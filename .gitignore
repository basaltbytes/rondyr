# A rule without a slash before its end, such as dist/ or .env, applies in every package.
# A rule with one, such as apps/rondyr/evals/out/, applies only to that path from the root.
node_modules/
dist/
.astro/
.alchemy/
.wrangler/
.miniflare/
.agent-sources/
.scratchpad/
.claude/worktrees/
# Third-party agent skills that the owner keeps locally, out of the repository.
.claude/skills/emil-*
.codex/
coverage/
test-results/
playwright-report/
worker-configuration.d.ts
*.tsbuildinfo
*.log
.DS_Store

.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Evaluation corpora with real submissions and evaluation output stay local (docs/evaluation.md).
apps/rondyr/evals/corpus/*
!apps/rondyr/evals/corpus/synthetic.jsonl
!apps/rondyr/evals/corpus/synthetic.context.txt
!apps/rondyr/evals/corpus/synthetic.domains.txt
apps/rondyr/evals/out/
# Before the move to apps/rondyr, they lived in evals/ at the root. A checkout from
# that time may still hold a real corpus there; it stays out of git too.
/evals/
