{
  "name": "rondyr",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:alchemy": "pnpm build && alchemy dev --config alchemy-run.ts --stage local",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "pnpm build && alchemy deploy --config alchemy-run.ts",
    "deploy:plan": "pnpm build && alchemy plan --config alchemy-run.ts",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run && node scripts/worker-budget.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cf:types": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate --config drizzle-config.ts",
    "db:check": "drizzle-kit check --config drizzle-config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "pnpm cf:types && effect-tsgo tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "doctor": "node scripts/doctor.mjs",
    "evaluate": "node evals/cli.ts",
    "i18n:check": "i18next-cli lint && i18next-cli extract --ci --dry-run",
    "i18n:extract": "i18next-cli extract"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@base-ui/react": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@rondyr/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "drizzle-kit": "catalog:",
    "i18next-cli": "catalog:",
    "miniflare": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
